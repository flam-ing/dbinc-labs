+def result_mail_html(r):
+    # 정산 결과 메일 본문. 메모는 이스케이프 없이 그대로 넣음 (지금 동작 유지)
+    html = mailer.HEAD
+    html += '<p>' + r['name'] + ' 님, 출장비 정산 결과를 알려 드립니다.</p>\n'
+    html += '<table border="1" cellpadding="4" style="border-collapse:collapse">\n'
+    html += '<tr><th>신청번호</th><td>' + r['req_id'] + '</td></tr>\n'
+    html += '<tr><th>출장</th><td>' + r['trip_k'] + ' ' + r['city'] + ' (' + str(r['dep']) + ' ~ ' + str(r['ret']) + ')</td></tr>\n'
+    if r['status'] == 'OK':
+        html += '<tr><th>일비</th><td align="right">' + won(r['per_diem']) + '</td></tr>\n'
+        html += '<tr><th>숙박</th><td align="right">' + won(r['hotel_ok']) + '</td></tr>\n'
+        html += '<tr><th>교통</th><td align="right">' + won(r['trans']) + '</td></tr>\n'
+        html += '<tr><th>기타</th><td align="right">' + won(r['etc'] + r['no_rcpt_ok']) + '</td></tr>\n'
+        html += '<tr><th>지급 합계</th><td align="right"><b>' + won(r['ok_amt']) + '</b></td></tr>\n'
+        if r['ng_amt'] > 0:
+            html += '<tr><th>불인정</th><td align="right" style="color:red">' + won(r['ng_amt']) + '</td></tr>\n'
+        html += '<tr><th>결재</th><td>' + r['line'].replace('>', ' &gt; ') + '</td></tr>\n'
+    else:
+        html += '<tr><th>결과</th><td style="color:red">반려 - ' + r['reason'] + '</td></tr>\n'
+    html += '</table>\n'
+    if r['memo']:
+        html += '<p>신청 메모: ' + r['memo'] + '</p>\n'
+    html += mailer.TAIL
+    return html
