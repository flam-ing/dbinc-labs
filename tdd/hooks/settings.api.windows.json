{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/hooks/gate.py\" --cwd api -- gradlew.bat test -q",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/hooks/gate.py\" --cwd api -- gradlew.bat test -q",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
