+// ---------- 최고 점수 (이 브라우저에만 저장해요) ----------
+const BEST_KEY = 'rabbit-carrot-best';
+
+function loadBest() {
+  try { return Number(localStorage.getItem(BEST_KEY)) || 0; } catch (e) { return 0; }
+}
+
+function saveBest(n) {
+  try { localStorage.setItem(BEST_KEY, String(n)); } catch (e) { /* 저장이 막혀도 게임은 계속돼요 */ }
+}
+
+function showBest(kind) {
+  const final = Math.floor(score), prev = loadBest();
+  const isNew = final > prev;
+  if (isNew) saveBest(final);
+  $(kind === 'over' ? 'over-best' : 'clear-best').textContent = `최고 점수 ${Math.max(final, prev)}점` + (isNew ? ' · 새 기록' : '');
+}
+
 function endGame(kind) {
   state = kind;
   stopMusic();
   draw();
+  showBest(kind);
   if (kind === 'over') {
     $('over-score').textContent = Math.floor(score) + '점';
     $('over').hidden = false;
